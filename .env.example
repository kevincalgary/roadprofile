# Copy to .env and fill in your Supabase project values.
# Never commit the real .env file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: a future approved VIN-decode provider. Leave blank to use the
# local fallback (format validation + RoadProfile records only, no spec
# guessing). See lib/services/vin-provider.ts.
EXPO_PUBLIC_VIN_PROVIDER=local
